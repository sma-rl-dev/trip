#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PORT="${PORT:-18185}"
RUN_ID="${RUN_ID:-}"

while (($#)); do
  case "$1" in
    --port) PORT="$2"; shift 2 ;;
    --run-id) RUN_ID="$2"; shift 2 ;;
    *) break ;;
  esac
done

COMMAND="${1:-help}"
SUFFIX="${RUN_ID:+-${RUN_ID}}"
PROJECT_NAME="tester-env-trip${SUFFIX}"
IMAGE_NAME="${IMAGE_TAG:-tester-env-trip:dev}"
COMPOSE=(docker compose -p "$PROJECT_NAME" -f "$SCRIPT_DIR/docker-compose.tester-env.yml")
URL="http://localhost:${PORT}"
USERNAME="tester"
PASSWORD="tester-env-trip-123"
if [[ -z "${NETWORK_SUBNET:-}" ]]; then
  read -r checksum _ < <(printf '%s' "${RUN_ID:-trip}" | cksum)
  NETWORK_SUBNET="10.181.$((100 + checksum % 100)).0/24"
fi
export NETWORK_SUBNET

api_token() {
  local response
  response="$(curl -fsS -X POST "$URL/api/auth/login" -H 'content-type: application/json' \
    -d "{\"username\":\"$USERNAME\",\"password\":\"$PASSWORD\"}")"
  python3 -c 'import json,sys; print(json.load(sys.stdin)["access_token"])' <<<"$response"
}

cmd_deploy() {
  echo "==> Building $IMAGE_NAME from source"
  PORT="$PORT" IMAGE_TAG="$IMAGE_NAME" "${COMPOSE[@]}" up --build -d
  echo "==> Waiting for $URL/api/info"
  for _ in {1..30}; do curl -fsS "$URL/api/info" >/dev/null && { echo "==> Running at $URL"; return; }; sleep 1; done
  "${COMPOSE[@]}" logs --tail=100
  return 1
}

cmd_seed() {
  echo "==> Creating deterministic user and itinerary"
  local registration token trips trip_id detail arrival_id summit_id has_item has_booking
  registration="$(curl -sS -o /dev/null -w '%{http_code}' -X POST "$URL/api/auth/register" -H 'content-type: application/json' \
    -d "{\"username\":\"$USERNAME\",\"password\":\"$PASSWORD\"}")"
  [[ "$registration" == 200 || "$registration" == 409 ]] || { echo "registration failed: HTTP $registration" >&2; return 1; }
  token="$(api_token)"
  trips="$(curl -fsS "$URL/api/trips" -H "Authorization: Bearer $token")"
  trip_id="$(python3 -c 'import json,sys; print(next((x["id"] for x in json.load(sys.stdin) if x["name"]=="Alpine Research Weekend"), ""))' <<<"$trips")"
  if [[ -z "$trip_id" ]]; then
    trip_id="$(curl -fsS -X POST "$URL/api/trips" -H "Authorization: Bearer $token" -H 'content-type: application/json' -d '{"name":"Alpine Research Weekend"}' | python3 -c 'import json,sys; print(json.load(sys.stdin)["id"])')"
  fi
  detail="$(curl -fsS "$URL/api/trips/$trip_id" -H "Authorization: Bearer $token")"
  arrival_id="$(python3 -c 'import json,sys; d=json.load(sys.stdin); print(next((x["id"] for x in d.get("days",[]) if x.get("label")=="Arrival"), ""))' <<<"$detail")"
  summit_id="$(python3 -c 'import json,sys; d=json.load(sys.stdin); print(next((x["id"] for x in d.get("days",[]) if x.get("label")=="Summit day"), ""))' <<<"$detail")"
  if [[ -z "$arrival_id" ]]; then
    arrival_id="$(curl -fsS -X POST "$URL/api/trips/$trip_id/days" -H "Authorization: Bearer $token" -H 'content-type: application/json' -d '{"label":"Arrival","dt":"2026-10-12","notes":"Check in before dinner."}' | python3 -c 'import json,sys; print(json.load(sys.stdin)["id"])')"
  fi
  if [[ -z "$summit_id" ]]; then
    curl -fsS -X POST "$URL/api/trips/$trip_id/days" -H "Authorization: Bearer $token" -H 'content-type: application/json' -d '{"label":"Summit day","dt":"2026-10-13","notes":"Summit hike and return."}' >/dev/null
  fi
  detail="$(curl -fsS "$URL/api/trips/$trip_id" -H "Authorization: Bearer $token")"
  arrival_id="$(python3 -c 'import json,sys; d=json.load(sys.stdin); print(next((x["id"] for x in d.get("days",[]) if x.get("label")=="Arrival"), ""))' <<<"$detail")"
  has_item="$(python3 -c 'import json,sys; d=json.load(sys.stdin); a=next((x for x in d.get("days",[]) if x.get("label")=="Arrival"), {}); print("yes" if any(i.get("text")=="Lodge check-in" for i in a.get("items",[])) else "")' <<<"$detail")"
  if [[ -z "$has_item" ]]; then
    curl -fsS -X POST "$URL/api/trips/$trip_id/days/$arrival_id/items" -H "Authorization: Bearer $token" -H 'content-type: application/json' -d '{"time":"18:30","text":"Lodge check-in","comment":"Reservation confirmed.","status":"booked"}' >/dev/null
  fi
  has_booking="$(python3 -c 'import json,sys; d=json.load(sys.stdin); a=next((x for x in d.get("days",[]) if x.get("label")=="Arrival"), {}); print("yes" if any(b.get("label")=="Alpine Lodge Reservation" for b in a.get("bookings",[])) else "")' <<<"$detail")"
  if [[ -z "$has_booking" ]]; then
    curl -fsS -X POST "$URL/api/trips/$trip_id/days/$arrival_id/bookings" -H "Authorization: Bearer $token" -H 'content-type: application/json' -d '{"type":"hotel","label":"Alpine Lodge Reservation","reference":"ALP-2026-1012","notes":"Two nights, breakfast included.","attachment_ids":[]}' >/dev/null
  fi
  echo "==> Seeded user $USERNAME and trip Alpine Research Weekend"
}

cmd_verify() {
  echo "==> Verifying deterministic seed"
  local token trips trip_id detail
  token="$(api_token)"
  trips="$(curl -fsS "$URL/api/trips" -H "Authorization: Bearer $token")"
  trip_id="$(python3 -c 'import json,sys; print(next((x["id"] for x in json.load(sys.stdin) if x["name"]=="Alpine Research Weekend"), ""))' <<<"$trips")"
  [[ -n "$trip_id" ]] || { echo "missing seeded trip" >&2; return 1; }
  detail="$(curl -fsS "$URL/api/trips/$trip_id" -H "Authorization: Bearer $token")"
  python3 -c 'import json,sys; d=json.load(sys.stdin); assert d["days"][0]["label"]=="Arrival"; assert d["days"][0]["items"][0]["text"]=="Lodge check-in"; a=next(x for x in d["days"] if x["label"]=="Arrival"); s=next(x for x in d["days"] if x["label"]=="Summit day"); assert str(s.get("dt","")).startswith("2026-10-13"); assert any(b["label"]=="Alpine Lodge Reservation" for b in a.get("bookings",[]))' <<<"$detail"
  echo "==> Verified Alpine Research Weekend / Arrival / Lodge check-in / Summit day / Alpine Lodge Reservation"
}

case "$COMMAND" in
  deploy) cmd_deploy ;;
  seed) cmd_seed ;;
  verify) cmd_verify ;;
  reset) echo "==> Removing Trip run containers and volume"; "${COMPOSE[@]}" down -v ;;
  stop) echo "==> Stopping Trip run"; "${COMPOSE[@]}" stop ;;
  status) PORT="$PORT" IMAGE_TAG="$IMAGE_NAME" "${COMPOSE[@]}" ps ; echo "==> $URL" ;;
  logs) "${COMPOSE[@]}" logs -f ;;
  help|--help|-h) printf '%s\n' 'Usage: ./tester-env [--port PORT] [--run-id ID] {deploy|seed|verify|reset|stop|status|logs}' ;;
  *) echo "unknown command: $COMMAND" >&2; exit 2 ;;
esac
